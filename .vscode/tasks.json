{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ruff: format",
      "type": "shell",
      "command": "uv run ruff format .",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "ruff: check",
      "type": "shell",
      "command": "uv run ruff check .",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": {
        "owner": "ruff",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\S+)\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "code": 4, "message": 5
        }
      }
    },
    {
      "label": "ty: check",
      "type": "shell",
      "command": "uv run ty check",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "prelaunch: format + lint + typecheck",
      "dependsOrder": "sequence",
      "dependsOn": ["ruff: format", "ruff: check", "ty: check"],
      "problemMatcher": []
    }
  ]
}
